# Optional, verified hospital contact details (never patient information)
# PostgreSQL on Supabase for now. Prisma is the only database connection.
# Runtime: use the pooled connection from Supabase Connect.
DATABASE_URL=
# Migrations: use a direct connection or a session pooler, not transaction pooling.
DIRECT_URL=
# Generate a random secret of at least 32 bytes. Server-only, never NEXT_PUBLIC_.
JWT_SECRET=
# Public origin when behind a reverse proxy, e.g. https://hospital.example.org
APP_ORIGIN=
# Bootstrap account. Remove ADMIN_PASSWORD after successful db:setup.
ADMIN_USERNAME=
# Optional; leave blank for a username-only account.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=ผู้ดูแลระบบ
# Absolute persistent directory OUTSIDE public/. Back up this directory with the DB.
# Example Windows: C:/hospital-data/documents ; Linux: /var/lib/hospital/documents
UPLOAD_DIR=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional: fill only when running npm run staff:add, then remove the password.
STAFF_USERNAME=
# Optional; leave blank for a username-only account.
STAFF_EMAIL=
STAFF_PASSWORD=
STAFF_NAME=
STAFF_ROLE=editor

NEXT_PUBLIC_HOSPITAL_ADDRESS=
NEXT_PUBLIC_HOSPITAL_PHONE=
NEXT_PUBLIC_HOSPITAL_EMAIL=

# Set only verified hospital coordinates
NEXT_PUBLIC_HOSPITAL_LAT=
NEXT_PUBLIC_HOSPITAL_LNG=
